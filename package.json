{
	"author": {
		"name": "Baptiste Pillot",
		"email": "baptiste@pillot.fr"
	},
	"dependencies": {
		"@itrocks/action": "latest",
		"@itrocks/action-request": "latest",
		"@itrocks/framework": "latest",
		"@itrocks/menu": "latest",
		"@itrocks/notifications": "latest",
		"@itrocks/route": "latest",
		"@itrocks/ux-core": "latest"
	},
	"description": "Default responsive it.rocks app container with navigation, user session, breadcrumb and notifications",
	"devDependencies": {
		"@types/node": "^24.10",
		"sass": "^1.95",
		"typescript": "^7.0"
	},
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": "./cjs/output.js",
		"./right-pane.css": "./right-pane.css",
		"./right-pane.js": {
			"types": "./right-pane.d.ts",
			"default": "./right-pane.js"
		}
	},
	"homepage": "https://it.rocks",
	"files": [
		"/*.css",
		"/*.d.ts",
		"/*.js",
		"LICENSE",
		"README.md",
		"cjs/*.d.ts",
		"cjs/*.html",
		"cjs/*.js",
		"config.yaml"
	],
	"keywords": [
		"backend",
		"component",
		"container",
		"homepage",
		"html",
		"it.rocks",
		"layout",
		"minimalist",
		"navigation",
		"notifications",
		"responsive",
		"standard",
		"template",
		"UI",
		"UX",
		"view"
	],
	"license": "ISC",
	"name": "@itrocks/home",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itrocks-ts/home.git"
	},
	"scripts": {
		"build": "npm run build:cjs && npm run build:front && npm run build:css",
		"build:cjs": "tsc && node -e \"const fs=require('node:fs'),path=require('node:path');for(const file of fs.readdirSync('src'))if(file.endsWith('.html'))fs.copyFileSync(path.join('src',file),path.join('cjs',file))\"",
		"build:front": "tsc -p src/front/tsconfig.json",
		"build:css": "sass --no-source-map src/right-pane.scss:right-pane.css"
	},
	"version": "1.0.2"
}
