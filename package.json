	"dependencies": {
		"@itrocks/action": "latest",
		"@itrocks/action-request": "latest",
		"@itrocks/framework": "latest",
		"@itrocks/menu": "latest",
		"@itrocks/notifications": "latest",
		"@itrocks/route": "latest",
		"@itrocks/ux-core": "latest"
	},
	"description": "Default responsive it.rocks app container with navigation, user session, breadcrumb and notifications",
	"devDependencies": {
		"@types/node": "^24.10",
		"typescript": "^7.0"
	},
	"engines": {
		"node": ">=24"
	},
	"exports": "./cjs/output.js",
	"homepage": "https://it.rocks",
	"files": [
		"config.yaml",
		"LICENSE",
		"README.md",
		"cjs/*",
		"!*.map"
	],
	"keywords": [
		"backend",
		"component",
		"container",
		"homepage",
		"html",
		"it.rocks",
		"layout",
		"minimalist",
		"navigation",
		"notifications",
		"responsive",
		"standard",
		"template",
		"UI",
		"UX",
		"view"
	],
	"license": "ISC",
	"name": "@itrocks/home",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itrocks-ts/home.git"
	},
	"scripts": {
		"build": "tsc && node -e \"const fs=require('node:fs'),path=require('node:path');for(const file of fs.readdirSync('src'))if(file.endsWith('.html'))fs.copyFileSync(path.join('src',file),path.join('cjs',file))\""
	},
	"version": "0.4.2"
}
